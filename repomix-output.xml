          </div>
        </>
      )}

      {filteredRecords.length >= pageSize && !searchTerm && (
        <div className="py-8 flex justify-center">
          <Button 
            variant="ghost" 
            size="sm" 
            onClick={() => setPageSize(prev => prev + 50)}
