                                <ShieldCheck className="h-4 w-4" /> Comprobante ISLR
                              </Button>
                              <Button 
                                variant="ghost" 
                                className="px-4 h-full hover:bg-amber-500/10 group/dl"
                                onClick={(e) => { e.stopPropagation(); handleDownload(record, 'islr'); }}
