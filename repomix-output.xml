              <div className="w-24 h-24 bg-slate-100 dark:bg-slate-900 rounded-[2.5rem] flex items-center justify-center shadow-inner relative group shrink-0">
                <div className="absolute inset-0 bg-slate-400 rounded-[2.5rem] blur-2xl opacity-20 group-hover:opacity-30 transition-opacity animate-pulse" />
