    } finally {
      setIsTogglingStatus(false);
    }
  };

  const handleDelete = async () => {
    if (!adminUser) return;
    setIsDeleting(true);
    try {
      const vehicleRef = doc(firestore, 'users', vehicle.sellerId, 'vehicleListings', vehicle.id);

      if (vehicle.images && vehicle.images.length > 0) {
