                      </div>
                    </div>
                  </div>

                  {isExpanded && (
                    <div className="px-5 pb-6 pt-2 space-y-5 animate-in slide-in-from-top-2 duration-300">
                      <div className="p-4 bg-background/40 rounded-2xl border border-white/5 italic">
