                      <div className="space-y-3">
                        <p className="text-[9px] font-black uppercase text-primary tracking-widest px-1">Documentos Disponibles</p>
                        
                        <div className="grid grid-cols-1 gap-3">
                          {/* Resumen Operación Group */}
